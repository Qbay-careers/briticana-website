# ============================================================================
# Briticana Django Backend - Environment Variables Example
# Copy this file to .env and configure values for your environment.
# NEVER commit .env or real secrets to version control.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Core & Environment Mode
# ----------------------------------------------------------------------------
# Options: local | production
DJANGO_ENV=local

# Generate a unique 64+ character cryptographic secret key for each environment:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-64-char-cryptographic-random-secret-key

# Must be False in production
DEBUG=True

# Comma-separated list of allowed hostnames (no wildcards in production)
ALLOWED_HOSTS=localhost,127.0.0.1

# ----------------------------------------------------------------------------
# 2. PostgreSQL Database Configuration (Least-Privilege User Required)
# ----------------------------------------------------------------------------
# Do NOT use the 'postgres' superuser in production. Use a dedicated role.
DB_NAME=briticana_db
DB_USER=briticana_app
DB_PASSWORD=replace-with-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=600
DB_SSLMODE=prefer

# Optional single connection URL (for managed cloud database platforms)
# DATABASE_URL=postgres://briticana_app:password@host:5432/briticana_db?sslmode=require

# ----------------------------------------------------------------------------
# 3. CORS & CSRF Security (Explicit Allowlist Only)
# ----------------------------------------------------------------------------
# Local: http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
# Production: https://briticana.com,https://www.briticana.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# ----------------------------------------------------------------------------
# 4. Cookie, Session & Transport Security
# ----------------------------------------------------------------------------
# In local mode (DJANGO_ENV=local), config/settings/local.py keeps HTTP cookies/redirects
# disabled so localhost HTTP works. In production mode (DJANGO_ENV=production), these are active:
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
CSRF_COOKIE_HTTPONLY=False
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_AGE=28800

# Security Headers
X_FRAME_OPTIONS=DENY
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ----------------------------------------------------------------------------
# 5. API Rate Limiting & Request Protection
# ----------------------------------------------------------------------------
THROTTLE_RATE_ANON=60/min
THROTTLE_RATE_USER=300/min
THROTTLE_RATE_HEALTH=30/min
THROTTLE_RATE_VERIFICATION_BURST=5/min
THROTTLE_RATE_VERIFICATION_SUSTAINED=20/hour

# Maximum JSON/form request body size in bytes (Default: 65536 = 64 KB)
MAX_API_REQUEST_BODY_BYTES=65536
DATA_UPLOAD_MAX_MEMORY_SIZE=65536
DATA_UPLOAD_MAX_NUMBER_FIELDS=100

# Set True only in local dev if you explicitly need the HTML Browsable API
ENABLE_BROWSABLE_API=False
